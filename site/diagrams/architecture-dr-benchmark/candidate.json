  "cards": [
    {
      "dot": "emerald",
      "title": "运行",
      "items": [
        "每个智能体做 2 道题，每道题 2 个版本，共 4 次",
        "智能体在题目公布前定下来，之后不能再改",
        "智能体中途提问，一律请它按自己的理解直接做"
      ]
    },
    {
      "dot": "rose",
      "title": "深度地图",
      "items": [
        "出题人在看到任何报告之前写成",
        "地图上写了、却没有报告写到的要点，不影响名次",
        "它只通过事先定好的层级和重要性影响分数"
      ]
    },
    {
      "dot": "cyan",
      "title": "计分",
      "items": [
        "编造来源等严重问题的报告，排在其他报告之后",
        "写对的深层内容得分，写错的扣分，换几种权重都领先才算分开",
        "评委有争议的判定只能让名次并列，不能拉开"
      ]
    },
    {
      "dot": "amber",
      "title": "复核",
      "items": [
        "评委的全部输出和计分程序随名次公开",
        "申诉由不参与评分的申诉专员裁决，改动后重算",
        "赛后统计深度地图漏了什么，用来改进下一届出题"
      ]
    }
